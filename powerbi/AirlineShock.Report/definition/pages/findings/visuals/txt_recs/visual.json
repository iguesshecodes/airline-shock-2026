                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Cutting seats held load factor at Ryanair UK and Air India but cost 5 to 7% of passengers. Cut only where the volume lost is worth less than the cost saved.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2. Add capacity only where demand is proven, and review load factor monthly.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
