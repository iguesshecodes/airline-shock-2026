              {
                "textRuns": [
                  {
                    "value": "1. Like for like, the shock was mild overall.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Capacity +0.7%, passengers +0.2%, load factor -0.5 pts (Mar to Aug 2026 vs 2025). The average hides large differences between airlines.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2. Adding capacity worked only where demand followed.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Jet2 grew seats 5.7% and passengers 8.9% while load factor rose 1.2 pts. easyJet added 7.2% more seats and lost 3.6 pts of load factor.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3. Cutting capacity protected load factor but cost passengers.",
                    "textStyle": {
                      "fontSize": "12pt",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Air India Group cut seats 9.0% and Ryanair UK 7.6%. Both held load factor (+0.5 and +0.3 pts) and lost 7.2% and 5.2% of passengers. TUI Airways is the exception: seats -3.7% and load factor -2.9 pts.",
                    "textStyle": {
                      "fontSize": "12pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
