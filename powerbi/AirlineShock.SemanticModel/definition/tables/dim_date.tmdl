table dim_date

	column month
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		sourceColumn: month

	column year
		dataType: int64
		summarizeBy: none
		sourceColumn: year

	column month_num
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: month_num

	column month_name
		dataType: string
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month_num

	column in_shock_window
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: in_shock_window

	column compare_window
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: compare_window

	partition dim_date = m
		mode: import
		source =
				let
					Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/iguesshecodes/airline-shock-2026/main/powerbi/data/dim_date.csv"), [Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"month", type date}, {"year", Int64.Type}, {"month_num", Int64.Type}, {"month_name", type text}, {"in_shock_window", Int64.Type}, {"compare_window", Int64.Type}}, "en-US")
				in
					Typed
